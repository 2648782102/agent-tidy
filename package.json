{
  "name": "agent-tidy",
  "version": "0.1.0",
  "description": "A one-command cleanup and safety check for a personal coding-agent setup",
  "type": "module",
  "bin": {
    "agent-tidy": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "check": "npm run typecheck && npm run test && npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2648782102/agent-tidy.git"
  },
  "keywords": [
    "codex",
    "claude-code",
    "mcp",
    "agent-skills",
    "cli",
    "developer-tools"
  ]
}
